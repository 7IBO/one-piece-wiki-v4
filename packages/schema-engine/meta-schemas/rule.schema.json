{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rule schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "schema_version": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "universes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning"
      ]
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "advisory",
        "blocking"
      ],
      "default": "advisory"
    },
    "labels": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "applies_to_entity_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "entity",
        "entry",
        "relation"
      ],
      "default": "entity"
    },
    "entry_property": {
      "type": "string"
    },
    "relation_type": {
      "type": "string"
    },
    "when": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property_latest_equals": {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "value": {}
            },
            "required": [
              "property"
            ],
            "additionalProperties": false
          },
          "has_active_relation": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "target_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "target": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "property_present": {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "property"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "expect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property_absent": {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "property"
            ],
            "additionalProperties": false
          },
          "property_present": {
            "type": "object",
            "properties": {
              "property": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "property"
            ],
            "additionalProperties": false
          },
          "max_concurrent_relations": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "entry_when": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualifier_equals": {
            "type": "object",
            "properties": {
              "qualifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "value": {}
            },
            "required": [
              "qualifier"
            ],
            "additionalProperties": false
          },
          "value_equals": {
            "type": "object",
            "properties": {
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "entry_expect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualifier_present": {
            "type": "object",
            "properties": {
              "qualifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "qualifier"
            ],
            "additionalProperties": false
          },
          "until_not_before_since": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "relation_when": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualifier_equals": {
            "type": "object",
            "properties": {
              "qualifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              },
              "value": {}
            },
            "required": [
              "qualifier"
            ],
            "additionalProperties": false
          },
          "target_type_is": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "relation_expect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "qualifier_present": {
            "type": "object",
            "properties": {
              "qualifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "qualifier"
            ],
            "additionalProperties": false
          },
          "qualifier_present_one_of": {
            "type": "object",
            "properties": {
              "qualifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
                },
                "minItems": 1
              }
            },
            "required": [
              "qualifiers"
            ],
            "additionalProperties": false
          },
          "qualifier_absent": {
            "type": "object",
            "properties": {
              "qualifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
              }
            },
            "required": [
              "qualifier"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [
    "id",
    "schema_version",
    "severity",
    "labels",
    "messages"
  ],
  "additionalProperties": false
}
