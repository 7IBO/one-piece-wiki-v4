{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qualifier-type schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "schema_version": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "universes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "base",
        "common"
      ]
    },
    "labels": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "descriptions": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "value_type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "enum",
        "multi_enum",
        "date",
        "entity_ref",
        "source_ref",
        "i18n_key",
        "markdown"
      ]
    },
    "enum_ref": {
      "type": "string"
    },
    "entity_type_filter": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      }
    },
    "multi": {
      "type": "boolean",
      "default": false
    },
    "mirrors_entry_value": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "schema_version",
    "kind",
    "labels",
    "value_type"
  ],
  "additionalProperties": false
}
