{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".vercel/output/**", "dist/**"]
    },
    "build:db": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@onepiece-wiki/web#build": {
      "dependsOn": ["^build", "@onepiece-wiki/db-builder#build:db"],
      "outputs": [".output/**", ".vercel/output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "__tests__/**",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
