{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "always",
    "quoteStyle": "preferSingle",
    "trailingCommas": "onlyMultiLine",
    "arrowFunction.useParentheses": "force"
  },
  "json": {
    "indentWidth": 2,
    "trailingCommas": "never"
  },
  "markdown": {
    "lineWidth": 80,
    "textWrap": "maintain"
  },
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.turbo",
    "**/.output",
    "**/.tanstack",
    "packages/schemas/generated",
    "packages/schema-engine/meta-schemas",
    "apps/dashboard/src/routeTree.gen.ts",
    "apps/web/src/routeTree.gen.ts"
  ],
  "plugins": [
    "node_modules/@dprint/typescript/plugin.wasm",
    "node_modules/@dprint/json/plugin.wasm",
    "node_modules/@dprint/markdown/plugin.wasm"
  ]
}
